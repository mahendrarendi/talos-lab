# Copy to .env, then confirm every value before generating configs.
CLUSTER_NAME=kubelab
CP_ENDPOINT=https://k8s-lab.internal:6443
# This name must resolve from every Talos node via your internal DNS.
CP1_IP=10.87.44.20
CP2_IP=
CP3_IP=
W1_IP=
INSTALL_DISK=/dev/vda
KUBERNETES_VERSION=1.36.0
TALOS_VERSION_CONTRACT=v1.14.1
TALOS_INSTALLER_IMAGE=factory.talos.dev/metal-installer/376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba:v1.14.1
# Use the existing secrets.yaml only if this is the same cluster identity.
SECRETS_FILE=secrets.yaml
# Optional Talos 1.14 patch, for example patches/resolver.yaml.
COMMON_PATCH=
# Set true only while the lab needs application pods on control planes.
CP_WORKLOADS=true
